        "---\n",
        "title: \"Aula 1: Espaços Vetoriais, Normas e Métricas\"\n",
        "subtitle: \"Álgebra Linear e Otimização para Aprendizado de Máquina\"\n",
        "author: \"Prof. Marcos Medeiros Raimundo\"\n",
        "format:\n",
        "  html:\n",
