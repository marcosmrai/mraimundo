        "#| echo: false\n",
        "#| fig-align: center\n",
        "import sys\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Semente fixa para reproducibilidade\n",
        "np.random.seed(42)\n",
        "\n",
        "# Gerando duas classes de dados sintéticos em R^2\n",
        "class_0 = np.random.multivariate_normal(mean=[2.0, 2.0], cov=[[0.6, 0.2],[0.2, 0.6]], size=15)\n",
        "class_1 = np.random.multivariate_normal(mean=[4.5, 4.0], cov=[[0.5, -0.1],[-0.1, 0.5]], size=15)\n",
        "\n",
        "X = np.vstack([class_0, class_1])\n",
        "y = np.array([0]*15 + [1]*15)\n",
        "\n",
        "# Ponto de teste (novo objeto de consulta)\n",
        "x_novo = np.array([3.2, 3.1])\n",
        "\n",
        "# Cálculo das distâncias euclidianas para todos os pontos\n",
        "dists = np.linalg.norm(X - x_novo, axis=1)\n",
        "\n",
        "# Ordenando os índices pelos mais próximos\n",
        "idx_sorted = np.argsort(dists)\n",
        "\n",
        "# Plot configurado\n",
        "fig, ax = plt.subplots(figsize=(8, 6))\n",
        "\n",
        "# Plot das amostras de treino\n",
        "ax.scatter(class_0[:, 0], class_0[:, 1], color='#1f77b4', s=70, label='Classe 0', edgecolors='k', zorder=3)\n",
        "ax.scatter(class_1[:, 0], class_1[:, 1], color='#ff7f0e', s=70, label='Classe 1', edgecolors='k', zorder=3)\n",
        "\n",
        "# Plot do ponto de teste\n",
        "ax.scatter(x_novo[0], x_novo[1], color='#d62728', marker='*', s=220, label=r'$\\mathbf{x}_{novo}$ (Consulta)', zorder=5, edgecolors='k')\n",
        "\n",
        "# Destacando k=3 vizinhos\n",
        "k = 3\n",
        "k_indices = idx_sorted[:k]\n",
        "max_dist_k = dists[idx_sorted[k-1]]\n",
        "\n",
        "# Círculo ilustrativo do raio k=3\n",
        "circle = plt.Circle((x_novo[0], x_novo[1]), max_dist_k + 0.08, color='gray', fill=False, linestyle='--', linewidth=2, label=f'Vizinhança ($k={k}$)')\n",
        "ax.add_patch(circle)\n",
        "\n",
        "# Linhas conectando x_novo aos k vizinhos\n",
        "for idx in k_indices:\n",
        "    ax.plot([x_novo[0], X[idx, 0]], [x_novo[1], X[idx, 1]], 'k:', alpha=0.7, linewidth=1.5)\n",
        "\n",
        "votos_c0 = np.sum(y[k_indices] == 0)\n",
        "votos_c1 = np.sum(y[k_indices] == 1)\n",
        "\n",
        "ax.set_title(f'Identificação de Vizinhança para $k={k}$ (Votos: Cls 0 = {votos_c0}, Cls 1 = {votos_c1})', fontsize=12, fontweight='bold')\n",
        "ax.set_xlabel('Característica $x_1$', fontsize=11)\n",
        "ax.set_ylabel('Característica $x_2$', fontsize=11)\n",
        "ax.grid(True, linestyle=':', alpha=0.6)\n",
        "ax.legend(loc='upper left')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
