    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "# Erro total esperado em função do corte — confirma o ótimo.\n",
    "erro_tot = PI_A * (1 - DIST_A.cdf(ts)) + PI_B * DIST_B.cdf(ts)\n",
    "i_min = int(np.argmin(erro_tot))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4.0))\n",
    "ax.plot(ts, erro_tot, color=COR_NEU, lw=2.8, label=\"erro total esperado\")\n",
    "ax.axvline(T_COND, color=COR_A, lw=1.8, ls=\":\",\n",
    "           label=f\"cruzamento das condicionais ({T_COND:.2f})\")\n",
    "ax.axvline(T_CONJ, color=COR_LIM, lw=2.2, ls=\"--\",\n",
    "           label=f\"cruzamento das conjuntas ({T_CONJ:.2f})\")\n",
    "ax.plot(ts[i_min], erro_tot[i_min], \"o\", color=COR_LIM, ms=9, zorder=5)\n",
    "ax.set_xlabel(\"posição do corte $t$\")\n",
    "ax.set_ylabel(r\"$\\pi_A\\,P(x>t\\mid A) + \\pi_B\\,P(x\\leq t\\mid B)$\")\n",
    "ax.set_title(\"O mínimo do erro total cai exatamente no cruzamento das conjuntas\")\n",
    "ax.legend(loc=\"upper center\", fontsize=9)\n",
    "ax.set_xlim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
