    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "fa1, es1, tot1 = contagem_erros(T_COND)\n",
    "fa2, es2, tot2 = contagem_erros(T_CONJ)\n",
    "\n",
    "rotulos = [f\"corte no cruzamento\\n$t = {T_COND:.2f}$\",\n",
    "           f\"corte deslocado\\n$t = {T_CONJ:.2f}$\"]\n",
    "alarmes = [fa1, fa2]\n",
    "escapes = [es1, es2]\n",
