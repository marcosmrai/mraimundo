    "xb = np.linspace(0.001, 0.999, 900)\n",
    "\n",
    "conjuntos = [\n",
    "    ([(0.5, 0.5), (0.2, 0.2), (0.8, 0.4)], \"$a,b < 1$: forma de U\"),\n",
    "    ([(1, 1), (1, 3), (3, 1)], \"$a=b=1$: uniforme; e os monótonos\"),\n",
