    "ax.set_xlabel(\"$x$\"); ax.set_ylabel(\"densidade ponderada\")\n",
    "ax.set_title(\"Encarecer o escape empurra a fronteira para a esquerda\")\n",
    "ax.legend(fontsize=8, loc=\"upper right\")\n",
