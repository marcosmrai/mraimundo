   "source": [
    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "# Ajuste da Beta apenas aos dados \"normais\" (classe A)\n",
    "m_hat, v_hat = xA.mean(), xA.var(ddof=1)\n",
    "s_hat = m_hat * (1 - m_hat) / v_hat - 1\n",
    "a_mom, b_mom = m_hat * s_hat, (1 - m_hat) * s_hat\n",
    "\n",
    "xA_clip = np.clip(xA, 1e-6, 1 - 1e-6)\n",
    "a_mle, b_mle, _, _ = stats.beta.fit(xA_clip, floc=0, fscale=1)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4.2))\n",
    "ax.hist(xA, bins=34, density=True, color=COR_A, alpha=0.28,\n",
    "        edgecolor=\"white\", linewidth=0.6, label=\"dados normais (classe A)\")\n",
    "ax.plot(grade, stats.beta.pdf(grade, a_mom, b_mom), color=COR_B, lw=2.6,\n",
    "        label=f\"momentos: $\\\\hat a={a_mom:.2f},\\\\ \\\\hat b={b_mom:.2f}$\")\n",
    "ax.plot(grade, stats.beta.pdf(grade, a_mle, b_mle), color=COR_LIM, lw=2.6,\n",
    "        ls=\"--\", label=f\"MLE numérica: $\\\\hat a={a_mle:.2f},\\\\ \\\\hat b={b_mle:.2f}$\")\n",
    "\n",
    "ax.set_xlabel(\"$x$\")\n",
    "ax.set_ylabel(\"densidade\")\n",
    "ax.set_title(\"Beta ajustada aos dados normais: momentos vs. máxima verossimilhança\")\n",
    "ax.legend(loc=\"upper right\", fontsize=9)\n",
    "ax.set_xlim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
