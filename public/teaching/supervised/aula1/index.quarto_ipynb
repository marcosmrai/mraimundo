   ],
   "source": [
    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "a_n, b_n = a_mle, b_mle\n",
    "dist_norm = stats.beta(a_n, b_n)\n",
    "alphas = [0.10, 0.05, 0.01]\n",
    "cores_a = [\"#F5B041\", \"#E67E22\", \"#922B21\"]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11.0, 4.2))\n",
    "\n",
    "ax = axes[0]\n",
    "ax.plot(grade, dist_norm.pdf(grade), color=COR_A, lw=2.6,\n",
    "        label=\"Beta ajustada aos normais\")\n",
    "for al, c in zip(alphas, cores_a):\n",
    "    t_al = dist_norm.ppf(1 - al)\n",
    "    msk = grade > t_al\n",
    "    ax.fill_between(grade[msk], dist_norm.pdf(grade[msk]), color=c, alpha=0.55)\n",
    "    ax.axvline(t_al, color=c, lw=1.6, ls=\"--\")\n",
    "    ax.text(t_al, 2.6 - 0.5 * alphas.index(al),\n",
    "            f\"  $\\\\alpha={al}$\\n  $t={t_al:.3f}$\", color=c,\n",
    "            fontsize=8.5, fontweight=\"bold\")\n",
    "ax.set_xlabel(\"$x$\"); ax.set_ylabel(\"densidade\")\n",
    "ax.set_title(\"O limiar é um quantil do modelo ajustado\")\n",
    "ax.legend(loc=\"upper right\", fontsize=9)\n",
    "ax.set_xlim(0, 1)\n",
    "\n",
    "ax = axes[1]\n",
    "ax.plot(ts, 1 - dist_norm.cdf(ts), color=COR_A, lw=2.8,\n",
    "        label=r\"Tipo I $= 1 - I_t(a,b)$\")\n",
    "ax.plot(ts, np.full_like(ts, np.nan), color=COR_B, lw=2.8,\n",
    "        label=\"Tipo II — indefinido\")\n",
    "ax.fill_between(ts, 0, 1, color=COR_B, alpha=0.06)\n",
    "ax.text(0.5, 0.55, \"não existe segunda curva\\npara traçar aqui\",\n",
    "        ha=\"center\", color=COR_B, fontsize=11, fontweight=\"bold\", style=\"italic\")\n",
    "ax.set_xlabel(\"limiar $t$\"); ax.set_ylabel(\"taxa de erro\")\n",
    "ax.set_title(\"Uma densidade: um erro calculável, um erro inexistente\")\n",
    "ax.legend(loc=\"upper right\", fontsize=9)\n",
    "ax.set_ylim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
