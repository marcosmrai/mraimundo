       "<Figure size 1456x650 with 2 Axes>"
      ]
     },
     "metadata": {
      "image/png": {
       "height": 632,
       "width": 1375
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "cenarios = [\n",
    "    (0.50, 0.50, COR_A, \"equilibrado  50:50\"),\n",
    "    (0.95, 0.05, COR_B, \"desbalanceado  95:5\"),\n",
    "    (0.999, 0.001, COR_LIM, \"extremo  999:1\"),\n",
    "]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11.2, 5.0))\n",
    "\n",
    "ax = axes[0]\n",
    "ax.plot(fpr, tpr, color=COR_NEU, lw=3.0, label=\"ROC — a mesma nos três casos\")\n",
    "ax.plot([0, 1], [0, 1], color=\"#BDC3C7\", lw=1.2, ls=\"--\")\n",
    "for pa, pb, c, lab in cenarios:\n",
    "    i, _ = ponto_operacao(pa, pb, 1, 1)\n",
    "    ax.plot(fpr[i], tpr[i], \"o\", color=c, ms=12, mec=\"white\", mew=1.5,\n",
    "            label=f\"{lab} $\\\\to t = {tg[i]:.2f}$\", zorder=5)\n",
    "ax.set_xlabel(\"Tipo I\"); ax.set_ylabel(r\"$1 - $ Tipo II\")\n",
    "ax.set_title(\"Mudar a priori não move a curva.\\nMove o ponto.\")\n",
    "ax.set_xlim(-0.02, 1.02); ax.set_ylim(-0.02, 1.02)\n",
    "ax.set_aspect(\"equal\")\n",
    "ax.legend(loc=\"lower right\", fontsize=8.5)\n",
    "\n",
    "ax = axes[1]\n",
    "for pa, pb, c, lab in cenarios:\n",
    "    custo = pa * (1 - DIST_A.cdf(ts)) + pb * DIST_B.cdf(ts)\n",
    "    ax.plot(ts, custo / custo.max(), color=c, lw=2.4, label=lab)\n",
    "    i = int(np.argmin(custo))\n",
    "    ax.plot(ts[i], custo[i] / custo.max(), \"o\", color=c, ms=9, zorder=5)\n",
    "ax.set_xlabel(\"limiar $t$\")\n",
    "ax.set_ylabel(\"erro total (normalizado)\")\n",
    "ax.set_title(\"O limiar ótimo se desloca com a priori\")\n",
    "ax.legend(fontsize=8.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "42cc1bb0",
   "metadata": {},
   "source": [
    "::: {.content-visible when-format=\"html\" unless-format=\"revealjs\"}\n",
    "\n",
    "Este é o retorno intelectual do laboratório, e não deve ser cortado.\n",
    "\n",
    "> **A ROC não muda quando a priori muda; o ponto de operação ótimo muda.**\n",
    "\n",
    "A razão é imediata: TPR e FPR são probabilidades **condicionais à classe\n",
    "verdadeira**, e portanto não dependem de $\\pi_k$. Já o custo esperado é uma\n",
    "combinação ponderada por $\\pi_k$, e o seu mínimo se desloca.\n",
    "\n",
    "Duas consequências que decorrem daí e valem como advertência de projeto:\n",
    "\n",
    "- **A AUC é insensível à priori e aos custos.** Ela mede a qualidade da\n",
    "  *ordenação* das pontuações, não a qualidade da *decisão*. Otimizar AUC e\n",
    "  depois usar $0{,}5$ como corte é resolver um problema e ignorar o outro.\n",
    "- **O paradoxo da acurácia.** Numa base com prevalência de 1 em 1.000, o\n",
    "  classificador que responde \"negativo\" para tudo atinge 99,9% de acurácia,\n",
    "  ROC degenerada e utilidade nula (DLFC §5.2.5, pp. 147–148). Acurácia sob\n",
    "  desbalanceamento severo não informa nada. Reportar matriz de confusão,\n",
    "  precisão e revocação — e, sempre que possível, o custo esperado sob a matriz\n",
    "  de perda declarada.\n",
    "\n",
    ":::\n",
    "\n",
    "::: {.content-visible when-format=\"revealjs\"}\n",
    "\n",
    "> **A ROC não muda quando a priori muda. O ponto de operação ótimo muda.**\n",
    "\n",
    "- TPR e FPR são **condicionais à classe verdadeira** $\\Rightarrow$ independem de $\\pi_k$\n",
    "- O custo esperado é ponderado por $\\pi_k$ $\\Rightarrow$ o mínimo se desloca\n",
    "\n",
    "::: {.fragment}\n",
    "- **AUC** mede ordenação, não decisão\n",
    "- **Paradoxo da acurácia:** 1 em 1.000 $\\Rightarrow$ \"sempre negativo\" acerta 99,9%\n",
    ":::\n",
    "\n",
    ":::"
   ]
  },
