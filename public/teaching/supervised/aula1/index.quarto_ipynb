    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4.2))\n",
    "\n",
    "ax.hist(xA, bins=32, density=True, color=COR_A, alpha=0.30,\n",
    "        edgecolor=\"white\", linewidth=0.6, label=\"dados da classe A\")\n",
    "ax.hist(xB, bins=20, density=True, color=COR_B, alpha=0.30,\n",
    "        edgecolor=\"white\", linewidth=0.6, label=\"dados da classe B\")\n",
    "\n",
    "ax.plot(grade, DIST_A.pdf(grade), color=COR_A, lw=2.6,\n",
    "        label=\"formato da classe A\")\n",
    "ax.plot(grade, DIST_B.pdf(grade), color=COR_B, lw=2.6,\n",
    "        label=\"formato da classe B\")\n",
    "\n",
    "ax.set_xlabel(\"$x$  (escore normalizado)\")\n",
    "ax.set_ylabel(\"densidade\")\n",
    "ax.set_title(\"Duas populações, uma variável: o formato dos dados\")\n",
    "ax.legend(loc=\"upper right\")\n",
    "ax.set_xlim(0, 1)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
