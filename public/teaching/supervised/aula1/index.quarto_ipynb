    "b1 = ax.bar(xpos, alarmes, 0.55, color=COR_A, alpha=0.85,\n",
    "            label=\"alarmes falsos (Tipo I)\")\n",
    "b2 = ax.bar(xpos, escapes, 0.55, bottom=alarmes, color=COR_B, alpha=0.85,\n",
