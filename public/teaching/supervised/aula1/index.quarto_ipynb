    "        label=\"Laplace\")\n",
    "ax.plot(x, stats.t.pdf(x, df=2), color=COR_LIM, lw=2.2, label=\"$t$, $\\\\nu=2$\")\n",
    "ax.set_title(r\"Suporte $\\mathbb{R}$ — mesma variância\")\n",
