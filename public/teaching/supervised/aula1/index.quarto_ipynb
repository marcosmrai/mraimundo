    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "mu_A2, mu_B2 = np.array([0.32, 0.38]), np.array([0.70, 0.62])\n",
    "cov_A2 = np.array([[0.016, 0.006], [0.006, 0.013]])\n",
    "cov_B2 = np.array([[0.012, -0.005], [-0.005, 0.016]])\n",
    "\n",
    "pA2 = rng.multivariate_normal(mu_A2, cov_A2, size=420)\n",
    "pB2 = rng.multivariate_normal(mu_B2, cov_B2, size=420)\n",
    "\n",
    "gx, gy = np.mgrid[0:1:220j, 0:1:220j]\n",
    "pos = np.dstack((gx, gy))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(6.4, 5.4))\n",
    "ax.scatter(pA2[:, 0], pA2[:, 1], s=13, color=COR_A, alpha=0.45, lw=0)\n",
    "ax.scatter(pB2[:, 0], pB2[:, 1], s=13, color=COR_B, alpha=0.45, lw=0)\n",
    "\n",
    "for mu, cov, cor in [(mu_A2, cov_A2, COR_A), (mu_B2, cov_B2, COR_B)]:\n",
    "    dens = stats.multivariate_normal(mu, cov).pdf(pos)\n",
    "    ax.contour(gx, gy, dens, levels=5, colors=cor, linewidths=1.6, alpha=0.9)\n",
    "\n",
    "ax.set_xlabel(\"$x_1$\")\n",
    "ax.set_ylabel(\"$x_2$\")\n",
    "ax.set_title(\"O mesmo objeto em 2D: nuvens e curvas de nível\")\n",
    "ax.set_xlim(0, 1)\n",
    "ax.set_ylim(0, 1)\n",
    "ax.set_aspect(\"equal\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
