    "#| fig-align: center\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4.2))\n",
    "\n",
    "ax.plot(grade, DIST_A.pdf(grade), color=COR_A, lw=2.6, label=\"classe A\")\n",
    "ax.plot(grade, DIST_B.pdf(grade), color=COR_B, lw=2.6, label=\"classe B\")\n",
    "ax.fill_between(grade, np.minimum(DIST_A.pdf(grade), DIST_B.pdf(grade)),\n",
    "                color=COR_NEU, alpha=0.25, label=\"região de sobreposição\")\n",
    "\n",
    "ax.axvline(T_COND, color=COR_LIM, lw=2.2, ls=\"--\")\n",
    "ax.annotate(f\"cruzamento\\n$t = {T_COND:.2f}$\",\n",
    "            xy=(T_COND, DIST_A.pdf(T_COND)), xytext=(T_COND + 0.14, 2.2),\n",
    "            color=COR_LIM, fontweight=\"bold\",\n",
    "            arrowprops=dict(arrowstyle=\"->\", color=COR_LIM, lw=1.6))\n",
    "\n",
    "ax.set_xlabel(\"$x$\")\n",
    "ax.set_ylabel(\"densidade\")\n",
    "ax.set_title(\"Onde você corta?\")\n",
    "ax.legend(loc=\"upper right\")\n",
    "ax.set_xlim(0, 1)\n",
