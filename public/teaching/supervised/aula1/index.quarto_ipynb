    "\n",
    "razoes = [1, 5, 10, 25]\n",
    "cores_r = [\"#5D6D7E\", \"#2471A3\", \"#117A65\", \"#922B21\"]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11.0, 4.2))\n",
    "\n",
    "ax = axes[0]\n",
    "ax.plot(grade, PI_A * fa, color=COR_A, lw=2.4,\n",
    "        label=r\"$\\pi_A\\,p(x\\mid\\mathcal{C}_A)$\")\n",
    "for r, c in zip(razoes, cores_r):\n",
    "    ax.plot(grade, r * PI_B * fb, color=c, lw=2.0, alpha=0.9,\n",
