    "ax.plot([0, 2, 2], [0.5, 0.5, 0], color=COR_NEU, lw=2.2, ls=\"--\",\n",
    "        label=\"Uniforme $[0,2]$\")\n",
    "ax.set_title(r\"Exponencial ($\\mathbb{R}^+$) e Uniforme\")\n",
    "ax.legend(fontsize=8)\n",
    "\n",
    "# Beta\n",
    "ax = axes[1, 2]\n",
    "for a_, b_, c in [(0.5, 0.5, COR_A), (1, 1, COR_NEU), (2, 5, COR_B),\n",
    "                  (6, 3, COR_LIM)]:\n",
    "    ax.plot(x01, stats.beta.pdf(x01, a_, b_), lw=2.2, color=c,\n",
    "            label=f\"$a={a_},\\\\ b={b_}$\")\n",
    "ax.set_ylim(0, 3.2)\n",
    "ax.set_title(r\"Beta — $[0,1]$\")\n",
    "ax.legend(fontsize=8)\n",
    "\n",
    "fig.suptitle(\"O catálogo, organizado por suporte\", fontweight=\"bold\", y=1.00)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
