    "\n",
    "# Caudas em escala log\n",
    "ax = axes[1, 0]\n",
    "ax.semilogy(x, stats.norm.pdf(x), color=COR_A, lw=2.2, label=\"Gaussiana\")\n",
    "ax.semilogy(x, stats.laplace.pdf(x, scale=1/np.sqrt(2)), color=COR_B, lw=2.2,\n",
