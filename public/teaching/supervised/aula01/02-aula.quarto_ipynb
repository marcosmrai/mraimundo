    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "razoes = [1, 5, 10, 25]\n",
    "cores_r = [\"#5D6D7E\", \"#2471A3\", \"#117A65\", \"#922B21\"]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11.0, 4.2))\n",
    "\n",
    "ax = axes[0]\n",
    "ax.plot(grade, PI_A * fa, color=COR_A, lw=2.4,\n",
    "        label=r\"$\\pi_A\\,p(x\\mid\\mathcal{C}_A)$\")\n",
    "for r, c in zip(razoes, cores_r):\n",
    "    ax.plot(grade, r * PI_B * fb, color=c, lw=2.0, alpha=0.9,\n",
    "            label=f\"$c_{{II}}/c_{{I}} = {r}$\")\n",
    "    t_r = cruzamento(lambda x, r=r: PI_A * DIST_A.pdf(x) - r * PI_B * DIST_B.pdf(x),\n",
    "                     0.20, 0.98)\n",
    "    ax.axvline(t_r, color=c, lw=1.3, ls=\"--\")\n",
    "ax.set_xlabel(\"$x$\"); ax.set_ylabel(\"densidade ponderada\")\n",
    "ax.set_title(\"Encarecer o escape empurra a fronteira para a esquerda\")\n",
    "ax.legend(fontsize=8, loc=\"upper right\")\n",
    "ax.set_xlim(0, 1); ax.set_ylim(0, 1.6)\n",
    "\n",
    "ax = axes[1]\n",
    "rr = np.linspace(0.2, 60, 400)\n",
    "t_otimos = [cruzamento(lambda x, r=r: PI_A * DIST_A.pdf(x) - r * PI_B * DIST_B.pdf(x),\n",
    "                       1e-3, 0.999) for r in rr]\n",
    "ax.semilogx(rr, t_otimos, color=COR_LIM, lw=2.8)\n",
    "ax.axhline(T_CONJ, color=COR_NEU, lw=1.4, ls=\":\",\n",
    "           label=f\"custos iguais ($t={T_CONJ:.2f}$)\")\n",
    "ax.axvline(PI_A / PI_B, color=COR_A, lw=1.4, ls=\"--\",\n",
    "           label=r\"$c_{II}/c_{I} = \\pi_A/\\pi_B = 19$\")\n",
    "ax.set_xlabel(r\"razão de custos  $c_{II}/c_{I}$\")\n",
    "ax.set_ylabel(\"limiar ótimo $t^\\\\star$\")\n",
    "ax.set_title(\"Custo e priori são a mesma alavanca\")\n",
    "ax.legend(fontsize=8.5)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
