   "source": [
    "#| echo: false\n",
    "#| fig-align: center\n",
    "\n",
    "# Matriz de confusão e curva ROC no limiar ótimo T_CONJ — reaproveita\n",
    "# fa2/es2 (Bloco \"A conta que desmente a intuição\") e tipo1/tipo2 (Bloco\n",
    "# \"Tipos de erros\"): é o mesmo sweep de limiar, replotado, não um novo cálculo.\n",
    "TP2, FN2, FP2, TN2 = N_B - es2, es2, fa2, N_A - fa2\n",
    "precisao = TP2 / (TP2 + FP2)\n",
    "recall_v = TP2 / (TP2 + FN2)\n",
    "fpr_v = FP2 / (FP2 + TN2)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9.4, 3.6))\n",
    "\n",
    "ax = axes[0]\n",
    "matriz = np.array([[TN2, FP2], [FN2, TP2]])\n",
    "ax.imshow(matriz, cmap=\"Purples\", alpha=0.55, vmin=0)\n",
    "for i in range(2):\n",
    "    for j in range(2):\n",
    "        ax.text(j, i, f\"{matriz[i, j]}\", ha=\"center\", va=\"center\",\n",
    "                fontsize=13, fontweight=\"bold\")\n",
    "ax.set_xticks([0, 1]); ax.set_xticklabels([\"previsto A\", \"previsto B\"])\n",
    "ax.set_yticks([0, 1]); ax.set_yticklabels([\"real A\", \"real B\"])\n",
    "ax.set_title(f\"Matriz de confusão em $t={T_CONJ:.2f}$\\n\"\n",
    "             f\"precisão={precisao:.2f}, recall={recall_v:.2f}\")\n",
    "\n",
    "ax = axes[1]\n",
    "ax.plot(tipo1, 1 - tipo2, color=COR_LIM, lw=2.6, label=\"curva ROC\")\n",
    "ax.plot(fpr_v, recall_v, \"o\", color=COR_A, ms=9, zorder=5,\n",
    "        label=f\"limiar ótimo: ({fpr_v:.2f}, {recall_v:.2f})\")\n",
    "ax.plot([0, 1], [0, 1], color=COR_NEU, lw=1.2, ls=\":\",\n",
    "        label=\"classificador aleatório\")\n",
    "ax.set_xlabel(\"FPR (Tipo I)\")\n",
    "ax.set_ylabel(\"TPR (recall)\")\n",
    "ax.set_title(\"Curva ROC — mesmo sweep do Bloco 1, replotado\")\n",
    "ax.legend(fontsize=8, loc=\"lower right\")\n",
    "ax.set_xlim(0, 1); ax.set_ylim(0, 1)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
