    "---\n",
    "title: \"Dados, Distribuições e Detecção de Anomalias\"\n",
    "subtitle: \"Aula 1 — Fundamentos Estatísticos do Aprendizado Supervisionado\"\n",
    "author: \"Marcos M. Raimundo — Instituto de Computação, UNICAMP\"\n",
    "date: today\n",
    "lang: pt-BR\n",
    "format:\n",
    "  html:\n",
    "    output-dir: \"output\"\n",
    "    code-fold: false\n",
    "    toc: true\n",
    "    toc-depth: 3\n",
    "    number-sections: true\n",
    "    fig-width: 6\n",
    "    fig-height: 3.5\n",
    "  revealjs:\n",
    "    output-dir: \"output\"\n",
    "    slide-number: true\n",
    "    smaller: true\n",
    "    scrollable: true\n",
    "    theme: simple\n",
    "    fig-width: 6\n",
