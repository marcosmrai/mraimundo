    "\n",
    "prev, sens, fpr_t = 0.01, 0.90, 0.03\n",
    "N = 10000\n",
    "doentes = N * prev\n",
    "vp, fn_ = doentes * sens, doentes * (1 - sens)\n",
    "fp, vn = (N - doentes) * fpr_t, (N - doentes) * (1 - fpr_t)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(4.4, 2.2))\n",
    "\n",
    "ax = axes[0]\n",
    "ax.bar([\"doentes\", \"saudáveis\"], [doentes, N - doentes],\n",
    "       color=[COR_B, COR_A], alpha=0.85)\n",
    "ax.set_title(\"População (10.000 pessoas)\")\n",
    "ax.set_ylabel(\"pessoas\")\n",
    "for i, v in enumerate([doentes, N - doentes]):\n",
    "    ax.text(i, v + 150, f\"{int(v)}\", ha=\"center\", fontweight=\"bold\")\n",
    "\n",
    "ax = axes[1]\n",
    "ax.bar([\"verdadeiros\\npositivos\", \"falsos\\npositivos\"], [vp, fp],\n",
    "       color=[COR_B, COR_A], alpha=0.85)\n",
    "ax.set_title(f\"Entre os {int(vp+fp)} testes positivos\\n\"\n",
    "             f\"$p(D\\\\mid+) = {vp/(vp+fp):.3f}$\")\n",
    "ax.set_ylabel(\"pessoas\")\n",
    "for i, v in enumerate([vp, fp]):\n",
