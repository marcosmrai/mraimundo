        "acc_plena2, acc_naive2 = acuracia(Xte2, yte2, plena2), acuracia(Xte2, yte2, naive2)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(4.6, 3.0))\n",
        "xpos = np.arange(2)\n",
        "ax.bar(xpos - 0.18, [acc_plena1, acc_plena2], width=0.35, color=COR_LIM, alpha=0.85, label=\"pleno\")\n",
        "ax.bar(xpos + 0.18, [acc_naive1, acc_naive2], width=0.35, color=COR_ALT, alpha=0.85, label=\"naive\")\n",
        "ax.set_xticks(xpos)\n",
        "ax.set_xticklabels([\"Cenário 1\\n(alinhado)\", \"Cenário 2\\n(genérico)\"])\n",
        "ax.set_ylabel(\"acurácia (dados de teste)\")\n",
        "ax.set_ylim(0.5, 1.0)\n",
        "ax.set_title(\"O custo real: quase sempre pequeno, raramente zero\")\n",
        "ax.legend(fontsize=9)\n",
        "for i, (p, n) in enumerate([(acc_plena1, acc_naive1), (acc_plena2, acc_naive2)]):\n",
        "    ax.text(i - 0.18, p + 0.01, f\"{p:.3f}\", ha=\"center\", fontsize=8)\n",
        "    ax.text(i + 0.18, n + 0.01, f\"{n:.3f}\", ha=\"center\", fontsize=8)\n",
        "plt.tight_layout()\n",
        "plt.show()"
