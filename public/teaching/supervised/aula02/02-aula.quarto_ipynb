      "source": [
        "#| echo: false\n",
        "#| fig-align: center\n",
        "\n",
        "SIGMA = np.array([[1.0, 0.85], [0.85, 1.0]])\n",
        "\n",
        "# Cenário 1 — Δμ alinhado a um autovetor de Σ: as fronteiras coincidem\n",
        "mu_a1, mu_b1 = np.array([1.0, 1.0]), np.array([-1.0, -1.0])\n",
        "X1, y1 = simular_populacao(1500, mu_a1, mu_b1, SIGMA)\n",
        "Xte1, yte1 = simular_populacao(4000, mu_a1, mu_b1, SIGMA)\n",
        "\n",
        "# Cenário 2 — Δμ genérico, não alinhado: as fronteiras divergem\n",
        "mu_a2, mu_b2 = np.array([1.4, 0.2]), np.array([-1.4, -0.2])\n",
        "X2, y2 = simular_populacao(1500, mu_a2, mu_b2, SIGMA)\n",
        "Xte2, yte2 = simular_populacao(4000, mu_a2, mu_b2, SIGMA)\n",
        "\n",
        "plena1, naive1 = ajustar_gaussiana_plena(X1, y1), ajustar_gaussiana_naive(X1, y1)\n",
        "plena2, naive2 = ajustar_gaussiana_plena(X2, y2), ajustar_gaussiana_naive(X2, y2)\n",
        "\n",
        "gx, gy = np.mgrid[-4:4:300j, -4:4:300j]\n",
        "grade_xy = np.dstack((gx, gy))\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(9.5, 4.4))\n",
        "\n",
        "for ax, (X, y, plena, naive, titulo) in zip(\n",
        "    axes,\n",
        "    [(X1, y1, plena1, naive1, \"Δμ alinhado — fronteiras coincidem\"),\n",
        "     (X2, y2, plena2, naive2, \"Δμ genérico — fronteiras divergem\")],\n",
        "):\n",
        "    ax.scatter(X[y == 1, 0], X[y == 1, 1], s=8, color=COR_A, alpha=0.35, lw=0)\n",
        "    ax.scatter(X[y == 0, 0], X[y == 0, 1], s=8, color=COR_B, alpha=0.35, lw=0)\n",
        "    z_plena = log_razao_posteriori(grade_xy.reshape(-1, 2), plena).reshape(gx.shape)\n",
        "    z_naive = log_razao_posteriori(grade_xy.reshape(-1, 2), naive).reshape(gx.shape)\n",
        "    ax.contour(gx, gy, z_plena, levels=[0], colors=COR_LIM, linewidths=2.4)\n",
        "    ax.contour(gx, gy, z_naive, levels=[0], colors=COR_ALT, linewidths=2.0, linestyles=\"--\")\n",
        "    ax.set_title(titulo, fontsize=10.5)\n",
        "    ax.set_xlabel(\"$x_1$\"); ax.set_ylabel(\"$x_2$\")\n",
        "    ax.set_xlim(-4, 4); ax.set_ylim(-4, 4); ax.set_aspect(\"equal\")\n",
        "\n",
        "axes[0].plot([], [], color=COR_LIM, lw=2.4, label=\"fronteira plena\")\n",
        "axes[0].plot([], [], color=COR_ALT, lw=2.0, ls=\"--\", label=\"fronteira naive\")\n",
        "axes[0].legend(fontsize=8, loc=\"upper left\")\n",
        "fig.suptitle(\"Mesma covariância compartilhada, duas fronteiras — quando elas coincidem?\", fontweight=\"bold\", y=1.02)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
