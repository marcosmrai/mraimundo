      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| echo: false\n",
    "#| fig-align: center\n",
    "import sys\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Garantindo acesso aos módulos locais em src\n",
    "sys.path.append('..')\n",
    "\n",
    "# Configuração estéticas para os gráficos\n",
    "plt.style.use('seaborn-v0_8-whitegrid' if 'seaborn-v0_8-whitegrid' in plt.style.available else 'default')\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "\n",
    "# Dados de exemplo: [Área (m²), Preço estimado (em milhares de R$)]\n",
    "dataset = np.array([\n",
    "    [50.0, 250.0],\n",
    "    [70.0, 380.0],\n",
    "    [90.0, 420.0],\n",
    "    [120.0, 600.0],\n",
    "    [35.0, 190.0]\n",
    "])\n",
    "\n",
    "# Plotando os pontos no Espaço de Features R^2\n",
    "ax.scatter(dataset[:, 0], dataset[:, 1], color='#1f77b4', s=80, edgecolors='k', zorder=3, label='Imóveis (Amostras)')\n",
    "\n",
    "for i, pt in enumerate(dataset):\n",
    "    ax.annotate(f' Imóvel {i+1}\\n x{i+1}=[{pt[0]:.0f}, {pt[1]:.0f}]ᵀ', \n",
    "                (pt[0], pt[1]), fontsize=9, xytext=(5, -5), textcoords='offset points')\n",
    "\n",
    "ax.set_title(r'Espaço de Características (Feature Space) em $\\mathbb{R}^2$', fontsize=13, fontweight='bold')\n",
    "ax.set_xlabel(r'Característica 1: Área ($m^2$)', fontsize=11)\n",
    "ax.set_ylabel(r'Característica 2: Preço (R$ mil)', fontsize=11)\n",
    "ax.set_xlim(20, 140)\n",
    "ax.set_ylim(100, 700)\n",
    "ax.legend(loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3eb79baa",
   "metadata": {},
   "source": [
    "---\n",
    "\n",
    "### Geometria das Operações Vetoriais em $\\mathbb{R}^2$\n",
    "\n",
    "::: {.content-visible when-format=\"html\" unless-format=\"revealjs\"}\n",
    "A soma e a multiplicação por escalar possuem interpretações geométricas intuitivas e cruciais para a compreensão da movimentação e transformação de dados no espaço:\n",
    "\n",
    "1. **Soma ($\\mathbf{u} + \\mathbf{v}$):** Regra do paralelogramo. Representa o deslocamento consecutivo no espaço de atributos.\n",
    "2. **Multiplicação ($\\alpha \\mathbf{u}$):** Mantém a direção do vetor (se $\\alpha > 0$), alterando apenas seu comprimento (ou invertendo o sentido se $\\alpha < 0$).\n",
    ":::\n",
    "\n",
    "::: {.content-visible when-format=\"revealjs\"}\n",
    "### Geometria das Operações Vetoriais\n",
    "\n",
    "* **Soma ($\\mathbf{u} + \\mathbf{v}$):** Combinação linear de forças/direções (Regra do Paralelogramo).\n",
    "* **Multiplicação por Escalar ($\\alpha \\mathbf{u}$):** Amplificação ou atenuamento de magnitude sem alterar a linha de ação.\n",
    ":::"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "b0abe53b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 672x576 with 1 Axes>"
      ]
     },
     "metadata": {
      "image/png": {
       "height": 565,
       "width": 663
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "#| echo: false\n",
    "#| fig-align: center\n",
    "fig, ax = plt.subplots(figsize=(7, 6))\n",
    "\n",
    "# Vetores de origem\n",
    "u = np.array([3.0, 1.0])\n",
    "v = np.array([1.0, 4.0])\n",
    "u_plus_v = u + v\n",
    "two_u = 2.0 * u\n",
    "\n",
    "origin = np.array([0, 0])\n",
    "\n",
    "# Função auxiliar para desenhar vetores\n",
    "def plot_vector(orig, vec, color, label):\n",
    "    ax.quiver(orig[0], orig[1], vec[0], vec[1], angles='xy', scale_units='xy', scale=1, \n",
    "              color=color, label=label, width=0.012)\n",
    "\n",
    "plot_vector(origin, u, '#2ca02c', r'$\\mathbf{u} = [3, 1]^T$')\n",
    "plot_vector(origin, v, '#ff7f0e', r'$\\mathbf{v} = [1, 4]^T$')\n",
    "plot_vector(origin, u_plus_v, '#d62728', r'$\\mathbf{u} + \\mathbf{v} = [4, 5]^T$')\n",
    "plot_vector(origin, two_u, '#9467bd', r'$2\\mathbf{u} = [6, 2]^T$')\n",
    "\n",
    "# Linhas pontilhadas para o paralelogramo\n",
    "ax.plot([u[0], u_plus_v[0]], [u[1], u_plus_v[1]], 'k--', alpha=0.4)\n",
    "ax.plot([v[0], u_plus_v[0]], [v[1], u_plus_v[1]], 'k--', alpha=0.4)\n",
    "\n",
    "ax.set_xlim(-1, 7)\n",
    "ax.set_ylim(-1, 6)\n",
    "ax.set_xlabel(r'$x_1$', fontsize=11)\n",
    "ax.set_ylabel(r'$x_2$', fontsize=11)\n",
    "ax.set_title(r'Interpretação Geométrica de Soma e Escalonamento', fontsize=12, fontweight='bold')\n",
    "ax.grid(True, linestyle=':', alpha=0.6)\n",
    "ax.legend(loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
